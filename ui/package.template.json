{
  "name": "@nddev/clipboard-ui",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "generate": "openapi-ts",
    "check": "biome check src preview tests locales *.json && oxlint --type-aware src preview && knip && bun node_modules/@typescript/native/bin/tsc --noEmit",
    "build": "bun build ./index.html --outdir ./dist --target browser --minify",
    "build:preview": "bun build ./preview/index.html --outdir ./dist-preview --target browser --minify",
    "test": "playwright test"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "i18next": "26.7.1",
    "i18next-icu": "2.6.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "knip": "6.44.1",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "6.0.3",
    "@typescript/native": "npm:typescript@7.0.2"
  }
}
