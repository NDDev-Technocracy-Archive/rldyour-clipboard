{
  "dependencies": {
    "i18next": "26.7.1",
    "i18next-icu": "2.6.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "knip": "6.44.1",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "6.0.3"
  },
  "name": "@nddev/clipboard-ui",
  "packageExtensions": {
    "i18next-icu": {
      "peerDependencies": {
        "i18next": "*"
      }
    }
  },
  "packageManager": "bun@1.4.4",
  "private": true,
  "scripts": {
    "build:preview": "bun build ./preview/index.html --outdir ./dist-preview --target browser --minify",
    "check": "biome check src preview tests locales *.json && oxlint --type-aware src preview && knip && bunx --no-install --package @typescript/native tsc --noEmit",
    "generate": "openapi-ts --input ../contracts/local-ipc.openapi.json --output generated/api --plugins @hey-api/typescript",
    "preview": "bun ./preview/server.ts",
    "test": "bunx --bun playwright test"
  },
  "type": "module",
  "version": "0.2.2"
}
