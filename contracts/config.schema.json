{
  "$id": "https://nddev.ai/schemas/clipboard/config/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "archive_dir": {
      "minLength": 1,
      "type": "string"
    },
    "budget_bytes": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "type": "integer"
    },
    "capture_native": {
      "type": "boolean"
    },
    "retention_days": {
      "maximum": 36500,
      "minimum": 0,
      "type": "integer"
    },
    "schema": {
      "const": 1,
      "type": "integer"
    },
    "socket_path": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema",
    "archive_dir",
    "socket_path",
    "budget_bytes",
    "retention_days",
    "capture_native"
  ],
  "title": "NDDev Clipboard configuration",
  "type": "object"
}
